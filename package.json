{
  "name": "haratsan-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "magomedcoder",
  "icon": "media/logo.png",
  "license": "MIT",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/magomedcoder/haratsan-vscode"
  },
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "haratsan.commentSelection",
        "title": "%command.commentSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.commentFile",
        "title": "%command.commentFile.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.openChat",
        "title": "%command.openChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.openChatPanel",
        "title": "%command.openChatPanel.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.openChatSidebar",
        "title": "%command.openChatSidebar.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.initProject",
        "title": "%command.initProject.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.addSelectionToChat",
        "title": "%command.addSelectionToChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.addToChat",
        "title": "%command.addToChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.explainSelection",
        "title": "%command.explainSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.improveSelection",
        "title": "%command.improveSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.addTerminalToChat",
        "title": "%command.addTerminalToChat.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.notebook.addCell",
        "title": "%command.notebook.addCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.notebook.explainCell",
        "title": "%command.notebook.explainCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.notebook.improveCell",
        "title": "%command.notebook.improveCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.notebook.generateCell",
        "title": "%command.notebook.generateCell.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.manageWorktrees",
        "title": "%command.manageWorktrees.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.hunk.accept",
        "title": "%command.hunkAccept.title%",
        "category": "%extension.category%"
      },
      {
        "command": "haratsan.hunk.reject",
        "title": "%command.hunkReject.title%",
        "category": "%extension.category%"
      }
    ],
    "keybindings": [
      {
        "command": "haratsan.openChat",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "haratsan.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "haratsan.commentSelection",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%configuration.haratsan.title%",
      "properties": {
        "haratsan.chatViewLocation": {
          "type": "string",
          "enum": [
            "panel",
            "sidebar",
            "both"
          ],
          "default": "both",
          "description": "%config.haratsan.chatViewLocation.description%",
          "enumDescriptions": [
            "%config.haratsan.chatViewLocation.panel%",
            "%config.haratsan.chatViewLocation.sidebar%",
            "%config.haratsan.chatViewLocation.both%"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "haratsan-sidebar",
          "title": "%viewsContainers.activitybar.haratsan-sidebar.title%",
          "icon": "media/logo.svg"
        }
      ],
      "panel": [
        {
          "id": "haratsan",
          "title": "%viewsContainers.panel.haratsan.title%",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "haratsan": [
        {
          "type": "webview",
          "id": "haratsan.chatView",
          "name": "%views.haratsan.chatView.name%",
          "icon": "media/logo.svg",
          "when": "config.haratsan.chatViewLocation != 'sidebar'"
        }
      ],
      "haratsan-sidebar": [
        {
          "type": "webview",
          "id": "haratsan.chatViewSidebar",
          "name": "%views.haratsan.chatView.name%",
          "icon": "media/logo.svg",
          "when": "config.haratsan.chatViewLocation != 'panel'"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "haratsan.hunk.accept",
          "when": "false"
        },
        {
          "command": "haratsan.hunk.reject",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "haratsan.addToChat",
          "when": "editorHasSelection && editorTextFocus",
          "group": "haratsan@0"
        },
        {
          "command": "haratsan.explainSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "haratsan@1"
        },
        {
          "command": "haratsan.improveSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "haratsan@2"
        },
        {
          "command": "haratsan.commentSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "haratsan@3"
        },
        {
          "command": "haratsan.commentFile",
          "when": "editorTextFocus",
          "group": "haratsan@4"
        }
      ],
      "terminal/context": [
        {
          "command": "haratsan.addTerminalToChat",
          "group": "haratsan@1"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "haratsan.notebook.addCell",
          "group": "haratsan@1"
        },
        {
          "command": "haratsan.notebook.explainCell",
          "group": "haratsan@2"
        },
        {
          "command": "haratsan.notebook.improveCell",
          "group": "haratsan@3"
        },
        {
          "command": "haratsan.notebook.generateCell",
          "group": "haratsan@4"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.haratsan/config.json",
          "**/haratsan/config.json"
        ],
        "url": "./schemas/haratsan-config.schema.json"
      },
      {
        "fileMatch": [
          "**/.haratsan/hooks.json",
          "**/haratsan/hooks.json"
        ],
        "url": "./schemas/haratsan-hooks.schema.json"
      },
      {
        "fileMatch": [
          "**/.haratsan/shell.json",
          "**/haratsan/shell.json"
        ],
        "url": "./schemas/haratsan-shell.schema.json"
      },
      {
        "fileMatch": [
          "**/.haratsan/references.json",
          "**/.haratsan/references/*.json"
        ],
        "url": "./schemas/haratsan-references.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "package:vsix": "vsce package --yarn --no-dependencies",
    "compile-tests": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:eval": "vscode-test --grep eval"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ignore": "^7.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
