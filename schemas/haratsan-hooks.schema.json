{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/magomedcoder/haratsan-vscode/main/schemas/haratsan-hooks.schema.json",
	"title": "Haratsan hooks",
	"description": "Project hooks (`.haratsan/hooks.json`). beforeSubmit / beforeShell / session.compacting / shell.env veto on exit ≠ 0; session.diff / file.watcher are notify-only. Env: HARATSAN_HOOK_EVENT + event-specific vars. shell.env stdout: JSON {\"env\":{...}} or KEY=value.",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"hooks": {
			"$ref": "#/$defs/hooksObject",
			"description": "Optional wrapper; top-level event keys are also accepted."
		},
		"beforeSubmit": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Veto on non-zero exit. Env: HARATSAN_HOOK_TEXT."
		},
		"beforeShell": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Veto on non-zero exit. Env: HARATSAN_HOOK_COMMAND."
		},
		"sessionDiff": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Notify-only (alias of session.diff). Env: HARATSAN_HOOK_TURN_ID, HARATSAN_HOOK_PATHS."
		},
		"session.diff": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Notify-only. Env: HARATSAN_HOOK_TURN_ID, HARATSAN_HOOK_PATHS."
		},
		"sessionCompacting": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Veto can block /compact (alias of session.compacting)."
		},
		"session.compacting": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Veto can block /compact."
		},
		"shellEnv": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Alias of shell.env. Before run_command; stdout env map; exit ≠ 0 vetoes."
		},
		"shell.env": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Before run_command spawn. Env: HARATSAN_HOOK_COMMAND, HARATSAN_HOOK_CWD. stdout JSON {\"env\":{K:V}} or KEY=value merges into process env. Exit ≠ 0 vetoes."
		},
		"fileWatcher": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Alias of file.watcher. Notify-only for `.haratsan/**` changes."
		},
		"file.watcher": {
			"$ref": "#/$defs/hookCommandList",
			"description": "Notify-only (debounced). Env: HARATSAN_HOOK_PATH, HARATSAN_HOOK_FILE_EVENT, HARATSAN_HOOK_PATHS, HARATSAN_HOOK_FILE_EVENTS."
		}
	},
	"additionalProperties": {
		"$ref": "#/$defs/hookCommandList",
		"description": "Future / unknown hook event lists."
	},
	"$defs": {
		"hookCommand": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"description": "Shell command string."
				},
				{
					"type": "object",
					"required": ["command"],
					"properties": {
						"command": {
							"type": "string",
							"minLength": 1
						},
						"matchers": {
							"type": "array",
							"items": {
								"oneOf": [
									{ "type": "string" },
									{
										"type": "object",
										"additionalProperties": true
									}
								]
							},
							"description": "Reserved - not enforced yet (forward-compatible)."
						}
					},
					"additionalProperties": true
				}
			]
		},
		"hookCommandList": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/hookCommand"
			}
		},
		"hooksObject": {
			"type": "object",
			"properties": {
				"beforeSubmit": { "$ref": "#/$defs/hookCommandList" },
				"beforeShell": { "$ref": "#/$defs/hookCommandList" },
				"sessionDiff": { "$ref": "#/$defs/hookCommandList" },
				"session.diff": { "$ref": "#/$defs/hookCommandList" },
				"sessionCompacting": { "$ref": "#/$defs/hookCommandList" },
				"session.compacting": { "$ref": "#/$defs/hookCommandList" },
				"shellEnv": { "$ref": "#/$defs/hookCommandList" },
				"shell.env": { "$ref": "#/$defs/hookCommandList" },
				"fileWatcher": { "$ref": "#/$defs/hookCommandList" },
				"file.watcher": { "$ref": "#/$defs/hookCommandList" }
			},
			"additionalProperties": {
				"$ref": "#/$defs/hookCommandList"
			}
		}
	}
}
