{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/magomedcoder/haratsan-vscode/main/schemas/haratsan-references.schema.json",
	"title": "Haratsan references",
	"description": "Named @alias / @ref pointers (`.haratsan/references.json` or `.haratsan/references/<alias>.json`).",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"version": {
			"type": "integer",
			"minimum": 1,
			"description": "Manifest version (currently 1)."
		},
		"references": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": {
						"$ref": "#/$defs/referenceEntry"
					},
					"description": "Map of alias * definition."
				},
				{
					"type": "array",
					"items": {
						"allOf": [
							{ 
								"$ref": "#/$defs/referenceEntry"
							},
							{
								"type": "object",
								"required": ["alias"],
								"properties": {
									"alias": {
										"type": "string",
										"pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
									}
								}
							}
						]
					}
				}
			]
		},
		"alias": {
			"type": "string",
			"pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
			"description": "For per-file `.haratsan/references/<alias>.json` entries."
		},
		"path": {
			"type": "string",
			"description": "Local path (workspace-relative or absolute)."
		},
		"git": {
			"type": "string",
			"description": "Git repository URL."
		},
		"branch": {
			"type": "string"
		},
		"description": {
			"type": "string"
		}
	},
	"additionalProperties": false,
	"$defs": {
		"referenceEntry": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"description": "Local path (workspace-relative or absolute)."
				},
				"git": {
					"type": "string",
					"description": "Git repository URL."
				},
				"branch": {
					"type": "string"
				},
				"description": {
					"type": "string"
				}
			},
			"anyOf": [
				{ 
					"required": ["path"]
				},
				{
					"required": ["git"]
				}
			],
			"additionalProperties": false
		}
	}
}
