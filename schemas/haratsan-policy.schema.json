{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/magomedcoder/haratsan-vscode/main/schemas/haratsan-policy.schema.json",
	"title": "Haratsan admin policy",
	"description": "Managed / admin policy (MDM-style MVP). Loaded from HARATSAN_ADMIN_POLICY, /etc/haratsan/policy.json (Unix), or %ProgramData%/haratsan/policy.json (Windows). Keys present here lock and force effective HaratsanSettings; project/UI cannot override them.",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema URL or path (metadata)."
		},
		"version": {
			"type": "integer",
			"description": "Policy document version (metadata)."
		},
		"description": {
			"type": "string",
			"description": "Human-readable note (metadata)."
		},
		"approvalPolicy": {
			"type": "object",
			"description": "Forced approval policy (shell / edits / delete / web / outside / task / skill)."
		},
		"autoApprove": { "type": "boolean" },
		"continueLoopOnDeny": { "type": "boolean" },
		"enableTerminal": { "type": "boolean" },
		"enableFileReading": { "type": "boolean" },
		"enableWorkspaceContext": { "type": "boolean" },
		"webSearchEnabled": { "type": "boolean" },
		"webFetchEnabled": { "type": "boolean" },
		"allowExternalDirectory": { "type": "boolean" },
		"otelEnabled": { "type": "boolean" },
		"otelEndpoint": { "type": "string" }
	},
	"additionalProperties": false
}
